# =============================================================================
# Monad TrainSync DePIN — x402 Orchestrator Server
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Monad Testnet RPC endpoint (HTTP)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Server wallet private key (pays gas for on-chain AgentCredit calls)
SERVER_WALLET_PRIVATE_KEY=0x_your_private_key_here

# Server wallet public address (receives x402 payments from workers)
SERVER_WALLET_ADDRESS=0x_your_server_wallet_public_address

# AgentCredit contract address (from Dev 1 after deploy)
# Leave as 0x_PLACEHOLDER to run backend without contract calls
AGENT_CREDIT_CONTRACT_ADDRESS=0x_PLACEHOLDER

# Payment amount in MON per data batch
PAYMENT_AMOUNT=0.001

# HTTP server port
SERVER_PORT=3001

# CORS origin (use * for development)
CORS_ORIGIN=*
